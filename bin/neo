#!/bin/bash
# Neo Code — terminal launcher, Claude Code style.
# Uses the kubectl access already available on this machine when possible (kubinote case).
# Otherwise (remote machine with no cluster access), asks for the scoped config on first run.
set -e

NAMESPACE="client-agent-core-staging"
SERVICE="neo"
LOCAL_PORT="18495"
REMOTE_PORT="8495"
BIN_DIR="$(dirname "$(readlink -f "$0")")"
TERM_SCRIPT="$BIN_DIR/neo_term.py"
SETUP_SCRIPT="$BIN_DIR/neo_setup.py"
NEOVIBE_KUBECONFIG="$HOME/.neovibe/kubeconfig"

# API key — always required, regardless of the machine.
if [ ! -f "$HOME/.neovibe/settings.local.json" ]; then
  python3 "$SETUP_SCRIPT" --api-key-only
fi

# Cluster access: try the kubectl already configured on this machine first (kubinote case).
if kubectl --context=kubinote get pods -n "$NAMESPACE" >/dev/null 2>&1; then
  KUBECTL_CONTEXT="kubinote"
elif [ -f "$NEOVIBE_KUBECONFIG" ] && KUBECONFIG="$NEOVIBE_KUBECONFIG" kubectl get pods -n "$NAMESPACE" >/dev/null 2>&1; then
  export KUBECONFIG="$NEOVIBE_KUBECONFIG"
  KUBECTL_CONTEXT="kubinote"
else
  # Neither works — remote machine never configured yet: ask for the scoped token.
  python3 "$SETUP_SCRIPT" --kubeconfig-only
  export KUBECONFIG="$NEOVIBE_KUBECONFIG"
  KUBECTL_CONTEXT="kubinote"
fi

cleanup() {
  if [ -n "$PF_PID" ]; then
    kill "$PF_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

kubectl --context="$KUBECTL_CONTEXT" port-forward -n "$NAMESPACE" "svc/$SERVICE" \
  "$LOCAL_PORT:$REMOTE_PORT" > /tmp/neo-portforward.log 2>&1 &
PF_PID=$!

# Wait for port-forward to be ready
for i in $(seq 1 20); do
  if curl -s -o /dev/null "http://localhost:$LOCAL_PORT/health" 2>/dev/null; then
    break
  fi
  sleep 0.5
done

NEO_URL="http://localhost:$LOCAL_PORT" python3 "$TERM_SCRIPT"
