#!/bin/bash
# Neo Code — lanceur terminal, façon `claude`.
# Configure automatiquement au premier lancement (comme `claude` demande une clé API),
# puis ouvre un port-forward vers l'agent et lance le client terminal — pas de navigateur.
set -e

NAMESPACE="client-agent-core-staging"
SERVICE="neo"
LOCAL_PORT="18495"
REMOTE_PORT="8495"
BIN_DIR="$(dirname "$(readlink -f "$0")")"
TERM_SCRIPT="$BIN_DIR/neo_term.py"
SETUP_SCRIPT="$BIN_DIR/neo_setup.py"
NEOVIBE_KUBECONFIG="$HOME/.neovibe/kubeconfig"

# Premier lancement — assistant de configuration (clé API + jeton), comme `claude` au démarrage.
if [ ! -f "$HOME/.neovibe/settings.local.json" ] || [ ! -f "$NEOVIBE_KUBECONFIG" ]; then
  python3 "$SETUP_SCRIPT"
fi

# Utilise le kubeconfig scopé neovibe s'il existe (machine distante), sinon le kubeconfig
# par défaut de la machine (cas d'usage sur kubinote lui-même, contexte 'kubinote').
if [ -f "$NEOVIBE_KUBECONFIG" ]; then
  export KUBECONFIG="$NEOVIBE_KUBECONFIG"
  KUBECTL_CONTEXT="kubinote"
else
  KUBECTL_CONTEXT="kubinote"
fi

cleanup() {
  if [ -n "$PF_PID" ]; then
    kill "$PF_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

kubectl --context="$KUBECTL_CONTEXT" port-forward -n "$NAMESPACE" "svc/$SERVICE" \
  "$LOCAL_PORT:$REMOTE_PORT" > /tmp/neo-portforward.log 2>&1 &
PF_PID=$!

# Attendre que le port-forward soit prêt
for i in $(seq 1 20); do
  if curl -s -o /dev/null "http://localhost:$LOCAL_PORT/health" 2>/dev/null; then
    break
  fi
  sleep 0.5
done

NEO_URL="http://localhost:$LOCAL_PORT" python3 "$TERM_SCRIPT"
